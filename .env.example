# Copy this file to .env.local and fill in the values.

# --- AI (required for analysis + draft replies) ---
ANTHROPIC_API_KEY=

# --- Database ---
# Local SQLite file by default. For deployment, point this at a Turso/libSQL URL.
DATABASE_URL=file:data/app.db
DATABASE_AUTH_TOKEN=

# --- Sources ---
# Bluesky search needs a login. Create an *app password* (not your main password)
# at https://bsky.app/settings/app-passwords
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Mastodon server to read public hashtag timelines from (no login needed)
MASTODON_INSTANCE=https://mastodon.social

# --- Outreach identity (used so every draft discloses who is writing) ---
SENDER_NAME=Alex
COMPANY_NAME=Amanet
